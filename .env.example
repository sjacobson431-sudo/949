# ---- Solana RPC (comma-separated, first = primary). Use reputable paid providers for LIVE. ----
TERM_RPC_URLS=https://api.mainnet-beta.solana.com
# Optional WebSocket endpoint for the primary RPC
TERM_RPC_WS_URL=

# ---- Storage ----
TERM_DATA_DIR=./data

# ---- Engine API (binds to localhost only) ----
TERM_API_PORT=8787
TERM_DASHBOARD_ORIGIN=http://localhost:3000

# ---- Startup mode: READ_ONLY | SIMULATION | LIVE (LIVE always requires re-auth in the UI) ----
TERM_START_MODE=READ_ONLY

# ---- Session security ----
TERM_IDLE_LOCK_MINUTES=15
TERM_MAX_SESSION_HOURS=12

# Headless unlock (NOT recommended: visible to same-user processes). Leave empty for interactive unlock.
TERM_VAULT_PASSWORD=

# ---- External providers ----
TERM_JUPITER_BASE_URL=https://lite-api.jup.ag
TERM_DEXSCREENER_BASE_URL=https://api.dexscreener.com

# ---- Logging: trace | debug | info | warn | error ----
TERM_LOG_LEVEL=info
